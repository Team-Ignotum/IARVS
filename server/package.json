{
  "name": "iarvs-intelligent-entrollment-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate": "prisma generate",
    "seed": "node prisma/seed.mjs",
    "test": "dotenv -e .env.test -- jest -i",
    "migrate:maindb": "npx prisma migrate dev",
    "migrate:testdb": "dotenv -e .env.test -- npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "db:delete": "npx prisma migrate reset --force",
    "db:reset": "npm run db:delete && npm run migrate:maindb && npm run seed",
    "ci": "npm run lint && tsc --noEmit && npm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.3.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.1.0",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
