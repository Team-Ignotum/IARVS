generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator client_js {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
  STAFF
  SUPER_STAFF
}

model User {
  id        Int      @id
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}