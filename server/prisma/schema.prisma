
generator client {
  provider = "prisma-client"
}

generator client_js {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
  STAFF
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CAStatus {
  PASS
  FAIL
}

enum PassStatus {
  PASS
  FAIL
  ELIGIBLE
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?
}

model Student {
  userId             Int           @id
  registrationNumber String        @unique
  intake             String?
  status             UserStatus    @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments     StudentEnrollment[]
  academicRecords AcademicRecord[]
}

model StudentEnrollment {
  id                  Int       @id @default(autoincrement())
  studentId           Int
  programmeId         Int
  curriculumVersionId Int
  startDate           DateTime
  endDate             DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [userId])

  @@index([studentId])
  @@index([programmeId])
  @@index([curriculumVersionId])
}

model AcademicRecord {
  id            Int        @id @default(autoincrement())
  studentId     Int
  moduleId      Int
  attemptNumber Int
  grade         String?
  caStatus      CAStatus
  passStatus    PassStatus 
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  student Student @relation(fields: [studentId], references: [userId])

  @@unique([studentId, moduleId, attemptNumber])
  @@index([studentId])
  @@index([moduleId])
}
