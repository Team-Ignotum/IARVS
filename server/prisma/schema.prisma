generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
  STAFF
  SUPER_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CAStatus {
  PASS
  FAIL
}

enum PassStatus {
  PASS
  FAIL
  ELIGIBLE
}

model User {
  id           Int        @id @default(autoincrement())
  userId       String     @unique
  email        String     @unique
  passwordHash String
  regNumber    String?    @unique
  stNumber     String?    @unique
  intake       String?
  status       UserStatus @default(ACTIVE)
  firstName    String
  lastName     String
  role         UserRole
  centerId     Int?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  center          Center? @relation(fields: [centerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  enrollments     StudentEnrollment[]
  academicRecords AcademicRecord[]

  @@map("users")
}

model Programme {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  duration    Int // Programme duration in years
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  curriculumVersions CurriculumVersion[]
  enrollments        StudentEnrollment[]

  @@map("programmes")
}

model CurriculumVersion {
  id            Int       @id @default(autoincrement())
  programmeId   Int
  versionCode   String
  name          String
  intake        String?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  programme       Programme           @relation(fields: [programmeId], references: [id])
  enrollments     StudentEnrollment[]
  modules         CurriculumModule[]
  academicRecords AcademicRecord[]

  @@unique([programmeId, versionCode])
  @@index([programmeId])
  @@map("curriculum_versions")
}

model StudentEnrollment {
  id                  Int       @id @default(autoincrement())
  studentId           String
  programmeId         Int
  curriculumVersionId Int
  startDate           DateTime
  endDate             DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student           User              @relation(fields: [studentId], references: [stNumber])
  programme         Programme         @relation(fields: [programmeId], references: [id])
  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id])

  @@index([studentId])
  @@index([programmeId])
  @@index([curriculumVersionId])
  @@map("student_enrollments")
}

model Module {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  level     Int
  credits   Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academicRecords    AcademicRecord[]
  curriculumMappings CurriculumModule[]

  @@map("modules")
}

model CurriculumModule {
  id                  Int      @id @default(autoincrement())
  curriculumVersionId Int
  moduleId            Int
  isCompulsory        Boolean  @default(true)
  level               Int
  createdAt           DateTime @default(now())

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Restrict)

  module Module @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([curriculumVersionId, moduleId])
  @@index([moduleId])
  @@map("curriculum_modules")
}

model AcademicRecord {
  id                  Int        @id @default(autoincrement())
  studentId           String
  moduleId            Int
  curriculumVersionId Int
  attemptNumber       Int
  grade               String?
  caStatus            CAStatus
  passStatus          PassStatus
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  student User @relation(fields: [studentId], references: [stNumber])

  module Module @relation(fields: [moduleId], references: [id])

  curriculumVersion CurriculumVersion @relation(fields: [curriculumVersionId], references: [id])

  @@unique([studentId, moduleId, attemptNumber])
  @@index([studentId])
  @@index([moduleId])
  @@index([curriculumVersionId])
  @@map("academic_records")
}

model Center {
  id         Int      @id @default(autoincrement())
  centerId   String   @unique
  centerName String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users User[]

  @@map("centers")
}
