generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator client_js {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
  STAFF
  SUPER_STAFF
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  WITHDRAWN
}

enum CAStatus {
  PASS
  FAIL
  NOT_APPLICABLE
}

enum PassStatus {
  PASS
  FAIL
  IN_PROGRESS
}

model User {
  id        Int      @id
  email     String   @unique
  password  String
  name      String
  role      UserRole @default(STUDENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?
}

model Student {
  id                 Int           @id @default(autoincrement())
  userId             Int           @unique
  registrationNumber String        @unique
  fullName           String
  intake             String?
  status             StudentStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user            User                @relation(fields: [userId], references: [id])
  enrollments     StudentEnrollment[]
  academicRecords AcademicRecord[]
}

model StudentEnrollment {
  id                  Int       @id @default(autoincrement())
  studentId           Int
  programmeId         Int
  curriculumVersionId Int
  startDate           DateTime
  endDate             DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([programmeId])
  @@index([curriculumVersionId])
}

model AcademicRecord {
  id               Int        @id @default(autoincrement())
  studentId        Int
  moduleId         Int
  attemptNumber    Int
  grade            String?
  caStatus         CAStatus
  passStatus       PassStatus
  creditsAttempted Decimal?
  creditsEarned    Decimal?
  gpaPoints        Decimal?
  isExempted       Boolean    @default(false)
  exemptionReason  String?
  repeatEligible   Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, moduleId, attemptNumber])
  @@index([studentId])
  @@index([moduleId])
}
